{
  "name": "patient-touch",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@patient-touch/web",
    "dev:mobile": "npm run start --workspace=@patient-touch/mobile",
    "dev:api": "npm run dev --workspace=@patient-touch/api",
    "build": "turbo run build",
    "build:web": "npm run build --workspace=@patient-touch/web",
    "build:api": "npm run build --workspace=@patient-touch/api",
    "check:mobile": "npm run typecheck --workspace=@patient-touch/mobile && npm run export --workspace=@patient-touch/mobile",
    "typecheck": "turbo run typecheck",
    "lint": "eslint apps packages tests --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^3.2.4"
  }
}
